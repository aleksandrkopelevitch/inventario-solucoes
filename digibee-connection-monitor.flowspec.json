  "flowSpec": {
    "disconnected-root:f582c3be-8ccb-4f03-959d-ee01782f5f83": [
      {
        "id": "3545a625-0374-4857-829c-5fc9c12c102a",
        "type": "connector",
        "name": "json-generator-connector",
        "stepName": "Carrega lista de endpoints monitorados",
        "doubleBracesAlias": "load-targets",
        "params": {
          "json": "{\n  \"targets\": {{ global.isol-monitor-targets }}\n}",
          "failOnError": true
        }
      },
      {
        "id": "db7a3da6-78d7-4295-836b-204db16643b1",
        "type": "connector",
        "name": "for-each-connector",
        "stepName": "Testa cada endpoint da lista",
        "doubleBracesAlias": "for-each-monitor",
        "params": {
          "itemIdentifier": "",
          "parallel": true,
          "failOnError": false,
          "onProcess": "db7a3da6-78d7-4295-836b-204db16643b1-onProcessTrack",
          "onException": "db7a3da6-78d7-4295-836b-204db16643b1-onExceptionTrack",
          "expression": "$.targets[*]"
        }
      },
      {
        "id": "bdf7f648-6af1-4668-baf9-de02507ee9e3",
        "type": "connector",
        "name": "rest-connector-v2",
        "stepName": "SVL - testa login (client credentials)",
        "doubleBracesAlias": "svl-token-check",
        "accountLabel": "",
        "accountLabels": { "custom-1": "svl-auth", "custom-2": "" },
        "params": {
          "url": "{{ global.url-token-svl }}",
          "operation": "POST",
          "headers": "{\"Content-Type\":\"application/json\"}",
          "body": "{\n    \"client_id\": {{ account.custom-1.username }},\n    \"client_secret\": {{ account.custom-1.password }},\n    \"audience\": \"{{ global.param-audience-svl }}\",\n    \"grant_type\": \"client_credentials\"\n}",
          "injectJWT": false,
          "readJWT": false,
          "injectConsumer": false,
          "injectPipelineKey": false,
          "injectTraceId": false,
          "stopOnClientError": false,
          "stopOnServerError": false,
          "overrideResponseCharset": true,
          "responseCharset": "UTF-8",
          "queryParams": "{}",
          "useDynamicAccount": false,
          "connectTimeout": "10000",
          "readTimeout": "10000",
          "writeTimeout": "",
          "callTimeout": "",
          "advanced": false,
          "sendBinaryFile": false
        }
      },
      {
        "id": "db9f8f68-6a2a-4c39-b98a-0a4ff8b2138d",
        "type": "connector",
        "name": "script-connector",
        "stepName": "Avalia login SVL",
        "doubleBracesAlias": "svl-eval",
        "params": {
          "code": "output = { ok: (message.status >= 200 && message.status <= 299), status: message.status };",
          "failOnError": true
        }
      },
      {
        "id": "2f15de3f-e587-4ee0-a161-33bc71524c85",
        "type": "connector",
        "name": "object-store-connector",
        "stepName": "Registra status SVL",
        "accountLabel": "dgb-internal-object-store-account",
        "doubleBracesAlias": "svl-upsert",
        "params": {
          "operation": "UPDATE",
          "objectStore": "isol-monitor-results",
          "unique": true,
          "isolated": false,
          "failOnError": false,
          "upsert": true,
          "objectId": "svl",
          "document": "{\n  $set: {\n    \"name\": \"SVL (login OAuth2)\",\n    \"url\": {{ global.url-token-svl }},\n    \"status\": {{ step.svl-eval.status }},\n    \"ok\": {{ step.svl-eval.ok }},\n    \"checkedAt\": {{ NOW() }}\n  }\n}"
        }
      },
      {
