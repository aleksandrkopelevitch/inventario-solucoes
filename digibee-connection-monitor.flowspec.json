      {
        "id": "1c2331fb-0066-4c88-9e0a-3ba3869cf3fe",
        "type": "connector",
        "name": "object-store-connector",
        "stepName": "Busca status atual de todos os endpoints",
        "accountLabel": "dgb-internal-object-store-account",
        "doubleBracesAlias": "find-all-results",
        "params": {
          "operation": "FIND",
          "objectStore": "isol-monitor-results",
          "unique": false,
          "isolated": false,
          "failOnError": false,
          "query": "{}"
        }
      },
      {
        "id": "311544a2-fa9e-42a2-8aea-4d678e3ab564",
        "type": "connector",
        "name": "script-connector",
        "stepName": "Monta relatório consolidado",
        "doubleBracesAlias": "report-builder",
        "params": {
          "code": "var rows = message.data || [];\nvar failures = rows.filter(function (r) { return r.ok === false; });\nvar oks = rows.filter(function (r) { return r.ok === true; });\nfunction esc(v) { return v == null ? '' : String(v); }\nvar htmlItems = failures.map(function (r) {\n  return '<li><strong>' + esc(r.name) + '</strong> (' + esc(r.url) + ') - status ' + esc(r.status) + '</li>';\n}).join('');\nvar htmlReport = '<p>' + failures.length + ' de ' + rows.length + ' endpoint(s) monitorados com falha:</p><ul>' + htmlItems + '</ul>';\nvar teamsLines = failures.map(function (r) {\n  return '- ' + esc(r.name) + ' (' + esc(r.url) + '): status ' + esc(r.status);\n}).join('\\n');\nvar teamsSummary = failures.length + ' de ' + rows.length + ' endpoint(s) com falha:\\n' + teamsLines;\noutput = {\n  total: rows.length,\n  failures: failures.length,\n  okCount: oks.length,\n  hasFailures: failures.length > 0,\n  htmlReport: htmlReport,\n  teamsBody: JSON.stringify({ title: 'Monitor Digibee - ' + failures.length + ' falha(s) detectada(s)', text: teamsSummary })\n};",
          "failOnError": true
        }
      },
      {
        "id": "d85c6677-78fa-44f1-b55a-d4ec249b1146",
        "type": "choice",
        "name": "",
        "stepName": "Existe alguma falha?",
        "when": [
          {
            "target": "notifica-falhas",
            "jsonPath": "$.[?(@.hasFailures == true)]"
          }
        ],
        "otherwise": "tudo-ok"
      }
    ],
