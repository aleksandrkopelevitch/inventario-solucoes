APP_NAME="Inventário de Soluções"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Digibee flowSpec generator (F8/F9) — Laravel\Ai AnonymousAgent provider/model
DIGIBEE_FLOWSPEC_AI_PROVIDER=gemini
DIGIBEE_FLOWSPEC_AI_MODEL=gemini-3.6-flash

# "Assiste IA" da documentação — provider/model do gerador de rascunhos
DOCS_AI_PROVIDER=gemini
DOCS_AI_MODEL=gemini-3.6-flash

# Chaves lidas pelo config/ai.php do pacote laravel/ai (provider => *_API_KEY)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Importação do GitBook (php artisan gitbook:import) — token pessoal com
# escopo space:read, criado em GitBook › Developer settings
GITBOOK_API_TOKEN=

# Digibee platform API (APLA — ingestion, deploy, battery, healing, promotion).
# Without these four, every `digibee:pipeline:*` and `digibee:flowspec:ingest`
# refuses before making any call. The JWT is a digibeectl TOKEN (Administration
# > Digibeectl), not an interactive session: it carries its own permission list
# with environment scoping, and `digibee:design:probe --diagnose` prints that
# list without touching the network.
#
# The token is valid for up to ten years — nothing expires to bound a leak — so
# on the server it is an ENCRYPTED environment variable (php artisan
# env:encrypt), never plaintext. The interactive digibeectl LOGIN stays banned
# from the server: it can create and delete deployments in production, and it is
# what `digibee:pipelines:pull` needs, which is why that command runs only on a
# workstation.
DIGIBEE_ENDPOINT=
DIGIBEE_REALM=
DIGIBEE_JWT=
DIGIBEE_APIKEY=

# THE GUARDRAIL: nothing deploys to an environment outside this list, and the
# promotion gate refuses before any call. Adding `prod` here is the explicit act
# that opens production — which is why it is configuration and not a command
# argument. Default: test
DIGIBEE_DEPLOYABLE_ENVIRONMENTS=test

# How many write -> deploy -> test -> correct cycles the healing loop may spend.
# Low on purpose: a round costs a REAL deployment in a realm that deletes
# nothing, and each one is litter somebody clears from the canvas by hand.
DIGIBEE_MAX_HEALING_ROUNDS=3
