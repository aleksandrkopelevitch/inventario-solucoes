          "sendBinaryFile": false,
          "body": "{{message.$}}",
          "rawMode": true,
          "saveAsLocalFile": false,
          "isInsecure": true,
          "retry": false,
          "compressBody": false,
          "forceHttp1": false,
          "disableConnectionPool": false,
          "invalidateSSLSessionsOnEveryCall": false,
          "enableFollowRedirect": true,
          "rawModeAsBase64": false
        }
      },
