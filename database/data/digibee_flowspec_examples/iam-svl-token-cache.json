  "flowSpec": {
    "disconnected-root:16cfa573-6493-446a-816d-942493e706c5": [
      {
        "id": "d7c1a2b3-0700-4a11-9b22-aa0011223344",
        "type": "connector",
        "name": "jslt-connector",
        "stepName": "De/Para rota SVL",
        "doubleBracesAlias": "jslt-depara",
        "params": {
          "payload": "{ \"acao\": \"{{ trigger.path }}\" }",
          "jsltExpr": "let a = if (.acao != null) .acao else \"\"\n{\n  \"svlPath\": if (contains(\"create\", $a)) \"/criacao\"\n             else if (contains(\"edit\", $a)) \"/editar\"\n             else if (contains(\"deactivate\", $a)) \"/desativar\"\n             else null\n}",
          "rawMode": false,
          "failOnError": false
        }
      },
      {
        "id": "48ff28a7-b8e3-4f77-8ae5-fe9e929de8d9",
        "type": "connector",
        "name": "jslt-connector",
        "stepName": "Aplica fallbacks IAM",
        "doubleBracesAlias": "jslt-4",
        "params": {
          "payload": "{{ message.$ }}",
          "jsltExpr": "let logradouro = if (.endereco != null and .endereco.logradouro != null and .endereco.logradouro != \"\") .endereco.logradouro else \"Rua Doutor Carlos Roberto Presgrave de Melo\"\nlet capNum = capture($logradouro, \"(?<num>[0-9]+)[^0-9]*$\")\nlet numero = if ($capNum.num != null) $capNum.num else \"21\"\nlet telefone = if (.telefone != null and .telefone != \"\") .telefone else \"9999999999\"\nlet celular = if (.celular != null and .celular != \"\") .celular else \"9999999999\"\nlet dtIni = capture(if (.dataInicio != null) .dataInicio else \"\", \"(?<a>[0-9]{4})(?<m>[0-9]{2})(?<d>[0-9]{2})\")\nlet dataIniVA = if ($dtIni.d != null) $dtIni.d + \"/\" + $dtIni.m + \"/\" + $dtIni.a + \" 00:00\" else null\nlet dataNascimento = if (.dataNascimento != null and .dataNascimento != \"\") .dataNascimento else if ($dtIni.d != null) $dtIni.d + \"/\" + $dtIni.m + \"/\" + $dtIni.a else null\n\n{\n  \"telefone\": $telefone,\n  \"celular\": $celular,\n  \"dataNascimento\": $dataNascimento,\n  \"endereco\": {\n    \"cep\": if (.endereco.cep != null and .endereco.cep != \"\") .endereco.cep else \"06422-110\",\n    \"logradouro\": $logradouro,\n    \"numero\": $numero,\n    \"bairro\": if (.endereco.bairro != null and .endereco.bairro != \"\") .endereco.bairro else \"Vila Iracema\",\n    \"cidade\": if (.endereco.cidade != null and .endereco.cidade != \"\") .endereco.cidade else \"Barueri\",\n    \"uf\": if (.endereco.uf != null and .endereco.uf != \"\") .endereco.uf else \"SP\",\n    * : .endereco\n  },\n  \"t3\": {\n    \"TELEFONE\": $telefone,\n    \"CELULAR\": $celular,\n    \"NUMERO\": $numero,\n    \"DATA_INI_VA\": if ($dataIniVA != null) $dataIniVA else .t3.DATA_INI_VA,\n    \"DATA_FIM_VA\": if (.t3.DATA_FIM_VA != null and .t3.DATA_FIM_VA != \"\") .t3.DATA_FIM_VA else \"99991231\",\n    * : .t3\n  },\n  \"t5\": {\n    \"DATA_INI_VA\": if ($dataIniVA != null) $dataIniVA else .t5.DATA_INI_VA,\n    \"DATA_FIM_VA\": if (.t5.DATA_FIM_VA != null and .t5.DATA_FIM_VA != \"\") .t5.DATA_FIM_VA else \"99991231\",\n    * : .t5\n  },\n  * : .\n}",
          "rawMode": false,
          "failOnError": false
        }
      },
      {
        "id": "a23b8b9b-ccd9-4017-a3ad-a8015280c2fb",
        "type": "connector",
        "name": "object-store-connector",
        "stepName": "Busca token em cache",
        "accountLabel": "dgb-internal-object-store-account",
        "doubleBracesAlias": "object-store-3",
        "params": {
          "operation": "FIND",
          "objectStore": "token-svl",
          "unique": false,
          "isolated": false,
          "failOnError": false,
          "query": "{ \"_id\": \"token\" }"
        }
      },
      {
        "id": "7642e93c-c568-435e-8032-d30959ad77de",
        "type": "connector",
        "name": "jslt-connector",
        "stepName": "Avalia validade do token",
        "doubleBracesAlias": "jslt-5",
        "params": {
          "payload": "{{ message.$ }}",
          "jsltExpr": "let agora = round(now() * 1000)\nlet item = if (.data != null and size(.data) > 0) .data[0] else null\n{\n  \"tokenValido\": $item != null and $item.expiresAt != null and $item.expiresAt > $agora,\n  \"token\": if ($item != null and $item.token != null) $item.token else \"\",\n  \"token_type\": if ($item != null and $item.token_type != null) $item.token_type else \"\",\n  \"svlPath\": {{ step.jslt-depara.svlPath }}\n}",
          "rawMode": false,
          "failOnError": false
        }
      },
      {
        "id": "399dc784-6ade-4b1d-a305-44ba462bee59",
        "type": "choice",
        "name": "",
        "stepName": "Choice",
        "when": [
          {
            "target": "Token válido (3)",
            "jsonPath": "$.[?(@.tokenValido == true)]"
          }
        ],
        "otherwise": "Token ausente ou expirado (3)"
      }
    ],
    "Token válido (3)": [
      {
        "id": "0f16c183-b717-4ec7-8b93-c8472d370db0",
        "type": "connector",
        "name": "log-connector",
        "stepName": "Reutilizando token em cache",
        "params": {
          "logLevel": "INFO",
          "message": "Token em cache ainda válido, reutilizando"
        }
      },
      {
        "id": "88cbccd1-b1ee-47a8-a7a7-60a6a6c95ada",
        "type": "connector",
        "name": "rest-connector-v2",
        "stepName": "Envia colaborador ao SVL",
        "doubleBracesAlias": "rest-v2-4",
        "accountLabels": {
          "custom-1": "",
          "custom-2": ""
